@PACKAGE_INIT@

if (NOT TARGET Zycore::Zycore)
    add_library(Zycore::Zycore STATIC IMPORTED)
    set_target_properties(Zycore::Zycore PROPERTIES
        IMPORTED_LOCATION_DEBUG "${PACKAGE_PREFIX_DIR}/lib/thirdparty/Debug/Zycore.lib"
        IMPORTED_LOCATION_RELWITHDEBINFO "${PACKAGE_PREFIX_DIR}/lib/thirdparty/RelWithDebInfo/Zycore.lib"
        INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include/thirdparty/zycore"
    )
endif()
include("${CMAKE_CURRENT_LIST_DIR}/NdGameSdkTargets.cmake")

# Ensure Debug builds use Debug libs from the devpack
get_property(_ndg_all_targets GLOBAL PROPERTY TARGETS)
foreach(_ndg_tgt IN LISTS _ndg_all_targets)
    if (TARGET ${_ndg_tgt} AND (_ndg_tgt MATCHES "^FDG::" OR _ndg_tgt MATCHES "^Zycore::"))
        get_target_property(_ndg_imported ${_ndg_tgt} IMPORTED)
        if (_ndg_imported)
            set_property(TARGET ${_ndg_tgt} PROPERTY MAP_IMPORTED_CONFIG_DEBUG DEBUG)
        endif()
    endif()
endforeach()

set(NdGameSdk_INCLUDE_DIR "${PACKAGE_PREFIX_DIR}/include")
set(NdGameSdk_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/include")

check_required_components(NdGameSdk)
